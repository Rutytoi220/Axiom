/* =====================================================================
   AXIOM Desktop v3.0 — Minimalist Dark Theme
   ===================================================================== */

/* ---- Global Application ---- */
QWidget {
    background-color: #121214;
    color: #f0f0f5;
    font-family: "Inter", "Segoe UI", "Ubuntu", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #121214;
}

/* ---- Scrollbars ---- */
QScrollBar:vertical {
    background: #1e1e22;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #3e3e4a;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #5e5e6e;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #1e1e22;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #3e3e4a;
    border-radius: 4px;
}

/* ---- Text Browser (Chat Area) ---- */
QTextBrowser#chatView {
    background-color: #16161a;
    border: none;
    padding: 12px;
    selection-background-color: #10b981;
    selection-color: #ffffff;
}

/* ---- Chat Input ---- */
QTextEdit#chatInput {
    background-color: #1e1e22;
    color: #f0f0f5;
    border: 1px solid #2e2e36;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13px;
}
QTextEdit#chatInput:focus {
    border: 1px solid #10b981;
}

/* ---- Toolbar ---- */
QToolBar {
    background-color: #1a1a1f;
    border-bottom: 1px solid #2e2e36;
    spacing: 6px;
    padding: 4px 10px;
}

/* ---- Tool Buttons ---- */
QToolButton {
    background-color: transparent;
    color: #a0a0b0;
    border: none;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 12px;
}
QToolButton:hover {
    background-color: #2e2e36;
    color: #f0f0f5;
}
QToolButton:pressed {
    background-color: #3e3e4a;
}

/* ---- Send Button ---- */
QPushButton#sendBtn {
    background-color: #10b981;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-weight: 600;
    font-size: 13px;
}
QPushButton#sendBtn:hover {
    background-color: #0ea572;
}
QPushButton#sendBtn:pressed {
    background-color: #059669;
}

/* ---- Auth Mode Buttons ---- */
QPushButton#authBasicBtn {
    background-color: #1e1e22;
    color: #f59e0b;
    border: 1px solid #f59e0b;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#authBasicBtn:checked {
    background-color: #f59e0b;
    color: #121214;
}

QPushButton#authAutopilotBtn {
    background-color: #1e1e22;
    color: #10b981;
    border: 1px solid #10b981;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#authAutopilotBtn:checked {
    background-color: #10b981;
    color: #121214;
}

QPushButton#authStrictBtn {
    background-color: #1e1e22;
    color: #ef4444;
    border: 1px solid #ef4444;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#authStrictBtn:checked {
    background-color: #ef4444;
    color: #ffffff;
}

/* ---- Expert Mode Toggle ---- */
QPushButton#expertToggleBtn {
    background-color: #1e1e22;
    color: #a0a0b0;
    border: 1px solid #2e2e36;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 11px;
}
QPushButton#expertToggleBtn:checked {
    background-color: #2e2e36;
    color: #10b981;
    border-color: #10b981;
}

/* ---- Dock Widget (Expert Drawer) ---- */
QDockWidget {
    background-color: #1a1a1f;
    color: #f0f0f5;
    border-left: 1px solid #2e2e36;
    titlebar-close-icon: url(none);
    titlebar-normal-icon: url(none);
}
QDockWidget::title {
    background-color: #1e1e22;
    color: #a0a0b0;
    text-align: left;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 1px solid #2e2e36;
}

/* ---- Expert Panel Text ---- */
QTextEdit#expertLog {
    background-color: #18181b;
    color: #d4d4d8;
    border: 1px solid #27272a;
    border-radius: 6px;
    font-family: "JetBrains Mono", "Consolas", "Courier New", monospace;
    font-size: 11px;
    padding: 8px;
}

/* ---- Status Bar ---- */
QStatusBar {
    background-color: #0e0e12;
    color: #a0a0b0;
    border-top: 1px solid #2e2e36;
    font-size: 11px;
    padding: 2px 8px;
}

/* ---- Labels ---- */
QLabel#modelLabel {
    color: #10b981;
    font-size: 11px;
    font-weight: 600;
}
QLabel#modeLabel {
    font-size: 11px;
    font-weight: 600;
}

/* ---- System Tray ---- */
QMenu {
    background-color: #1e1e22;
    color: #f0f0f5;
    border: 1px solid #2e2e36;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #2e2e36;
}
QMenu::separator {
    height: 1px;
    background-color: #2e2e36;
    margin: 4px 8px;
}
